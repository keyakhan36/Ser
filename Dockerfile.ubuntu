# =====================================================================
# 🐧 Base Image
# =====================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Bangkok

# =====================================================================
# 🧩 Install Dependencies (Optimized for Ubuntu 22.04)
# =====================================================================
RUN apt-get update && \
    # 1. Install prerequisites for adding repositories
    apt-get install -y software-properties-common && \
    # 2. Enable Universe/Multiverse (Required for libncurses5, libtinfo5)
    add-apt-repository universe && \
    add-apt-repository multiverse && \
    apt-get update && \
    # 3. Setup GitHub CLI Keyring
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && \
    # 4. Install All Packages
    apt-get install -y \
        # --- Core Tools ---
        git git-lfs openssh-server sudo curl wget ca-certificates \
        bash byobu screen tmux netcat-openbsd nano vim htop zip unzip tar gzip \
        build-essential python3 python3-pip openssl less coreutils util-linux \
        # --- Android Build Tools (Updated Names) ---
        adb autoconf automake axel bc bison ccache clang cmake expat fastboot flex \
        g++ g++-multilib gawk gcc gcc-multilib gnupg gperf imagemagick \
        lib32ncurses-dev lib32z1-dev libtinfo5 libc6-dev libcap-dev \
        libexpat1-dev libgmp-dev liblz4-dev liblzma-dev libmpc-dev libmpfr-dev \
        libncurses-dev libncurses5 libsdl1.2-compat-dev libssl-dev libtool libxml2 libxml2-utils \
        lzop maven ncftp patch patchelf pkg-config pngcrush pngquant \
        python3-pyelftools python3-dev re2c schedtool squashfs-tools \
        subversion texinfo w3m xsltproc zlib1g-dev lzip \
        libxml-simple-perl apt-utils rsync \
        # --- Python Compatibility ---
        python-is-python3 \
        # --- GitHub CLI ---
        gh && \
    # 5. Install Google Repo Tool
    mkdir -p /usr/bin && \
    curl https://storage.googleapis.com/git-repo-downloads/repo > /usr/bin/repo && \
    chmod a+x /usr/bin/repo && \
    # 6. Cleanup to reduce image size
    apt-get clean && rm -rf /var/lib/apt/lists/*

# =====================================================================
# 🧠 Prepare SSHD environment
# =====================================================================
RUN mkdir -p /var/run/sshd /var/empty/sshd && \
    chmod 755 /var/empty/sshd

# =====================================================================
# 🧱 Add reclient (BuildBuddy RBE client)
# =====================================================================
COPY rbe-client /opt/reclient
RUN chmod -R 755 /opt/reclient

# =====================================================================
# 🧠 Add entrypoint
# =====================================================================
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# =====================================================================
# 🔥 Expose SSH
# =====================================================================
EXPOSE 2700

# =====================================================================
# 🧩 Entrypoint
# =====================================================================
ENTRYPOINT ["/entrypoint.sh"]