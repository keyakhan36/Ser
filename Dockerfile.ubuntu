# =====================================================================
# 🐧 Base Image
# =====================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Bangkok

# =====================================================================
# 🧩 Install Dependencies (Slim & Optimized)
# =====================================================================
RUN apt-get update && \
    # Setup GitHub CLI Keyring
    apt-get install -y curl && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git git-lfs openssh-server sudo wget ca-certificates \
        bash byobu netcat-openbsd nano htop zip unzip tar gzip \
        build-essential python3 python3-pip openssl less coreutils util-linux \
        # --- Android Build Tools (ตัด Maven/SVN/Text-Browser ออก) ---
        adb autoconf automake bc bison ccache clang cmake expat fastboot flex \
        g++ g++-multilib gawk gcc gcc-multilib gnupg gperf \
        lib32ncurses-dev lib32z1-dev libc6-dev libcap-dev \
        libexpat1-dev libgmp-dev liblz4-dev liblzma-dev libmpc-dev libmpfr-dev \
        libncurses-dev libssl-dev libtool libxml2 libxml2-utils \
        lzop patch patchelf pkg-config pngcrush pngquant \
        python3-pyelftools python3-dev re2c schedtool squashfs-tools \
        xsltproc zlib1g-dev rsync \
        python-is-python3 \
        gh && \
    mkdir -p /usr/bin && \
    curl https://storage.googleapis.com/git-repo-downloads/repo > /usr/bin/repo && \
    chmod a+x /usr/bin/repo && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# =====================================================================
# 🧠 Prepare SSHD environment
# =====================================================================
RUN mkdir -p /var/run/sshd /var/empty/sshd && \
    chmod 755 /var/empty/sshd

# =====================================================================
# 🧱 Add reclient (BuildBuddy RBE client)
# =====================================================================
COPY rbe-client /opt/reclient
RUN chmod -R 755 /opt/reclient

# =====================================================================
# 🧠 Add entrypoint
# =====================================================================
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# =====================================================================
# 🔥 Expose SSH
# =====================================================================
EXPOSE 2700

# =====================================================================
# 🧩 Entrypoint
# =====================================================================
ENTRYPOINT ["/entrypoint.sh"]